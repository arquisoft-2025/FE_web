# API Configuration - HTTPS Secure Gateway
VITE_API_TOKEN=https://127.0.0.1:8080/api/v1/users
VITE_API_BASE_URL=https://127.0.0.1:8080/api/v1/donations
VITE_API_BASE_URL_IMAGE=https://127.0.0.1:8080/api/v1/notifications
VITE_API_SHOPPING_CART=https://127.0.0.1:8080/api/v1/cart

# For Docker containers, you might need to use:
# VITE_API_TOKEN=https://host.docker.internal:8080/api/v1/users
# VITE_API_BASE_URL=https://host.docker.internal:8080/api/v1/donations
# VITE_API_BASE_URL_IMAGE=https://host.docker.internal:8080/api/v1/notifications
# VITE_API_SHOPPING_CART=https://host.docker.internal:8080/api/v1/cart

# Or if your API is also containerized:
# VITE_API_TOKEN=https://api-gateway:8080/api/v1/users
# VITE_API_BASE_URL=https://api-gateway:8080/api/v1/donations

# Mail configuration (Mailjet)
MAILJET_API_KEY_PUBLIC=your_mailjet_public_key
MAILJET_API_KEY_PRIVATE=your_mailjet_private_key
MAIL_SENDER=your_sender@email.com