# API Configuration
VITE_API_TOKEN=http://127.0.0.1:5002
VITE_API_BASE_URL=http://127.0.0.1:5000

# For Docker containers, you might need to use:
# VITE_API_TOKEN=http://host.docker.internal:5002
# VITE_API_BASE_URL=http://host.docker.internal:5000

# Or if your API is also containerized:
# VITE_API_TOKEN=http://api-container:5002
# VITE_API_BASE_URL=http://api-container:5000