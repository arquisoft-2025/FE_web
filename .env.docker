# Environment Configuration for Docker

# WSL2/Podman Configuration (recommended for Windows + WSL2)
VITE_API_TOKEN=http://172.24.32.1:5002
VITE_API_BASE_URL=http://172.24.32.1:5000

# Alternative configurations (uncomment as needed):

# For Docker Desktop:
# VITE_API_TOKEN=http://host.docker.internal:5002
# VITE_API_BASE_URL=http://host.docker.internal:5000

# For Linux Docker:
# VITE_API_TOKEN=http://172.17.0.1:5002
# VITE_API_BASE_URL=http://172.17.0.1:5000

# For different WSL network (check with ipconfig):
# VITE_API_TOKEN=http://[YOUR_WSL_IP]:5002
# VITE_API_BASE_URL=http://[YOUR_WSL_IP]:5000